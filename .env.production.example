# Production environment variables (set in your hosting dashboard)
NODE_ENV=production
PORT=3001
DATA_DIR=/data

# Optional integrations
# Set ESK_VALUES_ONLY=true to skip Excel formulas and the Orders sheet (lower memory).
# Leave unset on Render to emit full formula output like local dev.
CRON_ENABLED=false
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-10
STRIPE_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
