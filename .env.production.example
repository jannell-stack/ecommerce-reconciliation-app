# Production environment variables (set in your hosting dashboard)
NODE_ENV=production
PORT=3001
DATA_DIR=/data
# Pro Standard (2 GB): --max-old-space-size=1536
# Pro Pro Plus (4 GB): --max-old-space-size=3072
NODE_OPTIONS=--max-old-space-size=1536

# Optional integrations
CRON_ENABLED=false
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-10
STRIPE_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
